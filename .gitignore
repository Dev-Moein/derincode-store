# Laravel environment and secrets
backend/.env
backend/.env.*
!backend/.env.example
backend/auth.json

# Database dumps and local exports (never commit real data)
*.sql
*.sql.gz
*.dump
*.bak
*.backup
backups/
database-backups/

# Laravel runtime
backend/storage/*.key
backend/storage/app/*
backend/storage/framework/*
backend/storage/logs/*
backend/bootstrap/cache/*

# Dependencies and generated assets
backend/vendor/
backend/node_modules/
backend/public/build/
frontend/node_modules/
frontend/dist/

# Docker persistent data
mysql_data/
redis_data/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and local test artifacts
*.log
.phpunit.result.cache
